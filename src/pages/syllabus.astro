---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientText from '../components/GradientText.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { grading, policies } from '../data/syllabus';
import { course } from '../data/course';

const sessions = await getCollection('sessions');
const sorted = sessions.sort((a, b) => a.data.number - b.data.number);
---

<BaseLayout title="ISOM 260 | Syllabus">
  <section class="py-24 px-8 max-w-[1200px] mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold mb-4">
        Course <GradientText>Syllabus</GradientText>
      </h1>
      <p class="text-text-secondary text-lg max-w-[600px] mx-auto">
        {course.code}: {course.title} &bull; {course.semester}
      </p>
    </div>
  </section>

  <!-- Schedule -->
  <section class="py-12 px-8 max-w-[1200px] mx-auto">
    <SectionHeader number="01" label="Schedule" title="Session Schedule" description="13 sessions across Mon & Wed meetings, 12:30–1:45 PM, 73 Tremont 5065. No class: Mon Oct 12 (October Break), Wed Nov 11 (Veterans Day), Wed Nov 25 (Thanksgiving)." />
    <div class="grid gap-4">
      {sorted.map((session) => (
        <a href={`/sessions/${session.data.slug}`} class="flex items-center gap-6 px-6 py-5 bg-bg-card border border-border-subtle rounded-xl transition-all duration-300 no-underline text-inherit hover:border-accent-cyan/30 hover:translate-x-2 fade-in">
          <div class="font-mono text-2xl font-bold bg-gradient-to-br from-accent-cyan to-accent-purple bg-clip-text text-transparent shrink-0 w-10">
            {String(session.data.number).padStart(2, '0')}
          </div>
          <div class="flex-1 min-w-0">
            <div class="font-semibold">{session.data.title}</div>
            <div class="text-text-secondary text-sm truncate">{session.data.subtitle}</div>
          </div>
          {session.data.meetings?.length > 0 && (
            <div class="font-mono text-xs text-accent-cyan/80 shrink-0 hidden md:block text-right leading-relaxed">
              {session.data.meetings.map((m: string) => <div>{m}</div>)}
            </div>
          )}
          <Icon name="chevron-right" class="w-5 h-5 text-text-muted shrink-0" />
        </a>
      ))}
    </div>
  </section>

  <!-- Key Dates -->
  <section class="py-12 px-8 max-w-[1200px] mx-auto">
    <SectionHeader number="02" label="Key Dates" title="Mark Your Calendar" />
    <div class="grid gap-4 md:grid-cols-2 fade-in">
      {[
        { date: 'Wed Oct 21', what: 'Midterm Project assigned', note: 'In Session 6 — build your first complete agent (20% of grade)' },
        { date: 'Mon Nov 2', what: 'Midterm Project due', note: 'Submit on Canvas before class, 12:30 PM' },
        { date: 'Mon Nov 30 & Wed Dec 2', what: 'Final Project Workshop', note: 'Teams form, scope locks, skeletons built — Session 12' },
        { date: 'Mon Dec 7 & Wed Dec 9', what: 'Demo Days', note: 'Live 5-minute demos + Q&A with peer voting — Session 13' },
        { date: 'Wed Dec 9 · 11:59 PM', what: 'Final Project due', note: 'Notebook + 1-page brief on Canvas' },
        { date: 'Tue Dec 15', what: 'Final exam slot', note: 'Reserved per the university schedule' },
      ].map((item) => (
        <div class="flex items-start gap-4 px-6 py-5 bg-bg-card border border-border-subtle rounded-xl">
          <Icon name="calendar" class="w-5 h-5 text-accent-cyan shrink-0 mt-1" />
          <div class="min-w-0">
            <div class="font-mono text-sm text-accent-cyan mb-1">{item.date}</div>
            <div class="font-semibold">{item.what}</div>
            <div class="text-text-secondary text-sm">{item.note}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Grading -->
  <section class="py-12 px-8 max-w-[1200px] mx-auto">
    <SectionHeader number="03" label="Grading" title="Grade Breakdown" />
    <div class="grid gap-4 fade-in">
      {grading.map((item) => (
        <div class="flex items-center justify-between px-6 py-5 bg-bg-card border border-border-subtle rounded-xl">
          <span class="font-medium">{item.component}</span>
          <span class="font-mono text-accent-cyan font-bold text-lg">{item.weight}%</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Policies -->
  <section class="py-12 px-8 max-w-[1200px] mx-auto">
    <SectionHeader number="04" label="Policies" title="Course Policies" />
    <div class="grid gap-6 md:grid-cols-2 fade-in">
      {policies.map((policy) => (
        <div class="bg-bg-card border border-border-subtle rounded-2xl p-8">
          <h3 class="text-lg font-semibold mb-3 text-accent-cyan">{policy.title}</h3>
          <p class="text-text-secondary text-sm leading-relaxed">{policy.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Graduate track footer link -->
  <section class="pt-8 pb-16 px-8 max-w-[1200px] mx-auto">
    <div class="border-t border-border-subtle pt-8 text-center">
      <a href="/isom-900" class="inline-flex items-center gap-2 font-mono text-[0.8rem] tracking-wide text-grad-violet no-underline transition-colors duration-300 hover:text-grad-violet/80">
        Graduate track → ISOM 900
      </a>
    </div>
  </section>
</BaseLayout>
